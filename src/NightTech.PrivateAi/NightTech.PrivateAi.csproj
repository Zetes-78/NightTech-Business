<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NightTech.PrivateAi</RootNamespace>
    <AssemblyName>NightTechPrivateAi</AssemblyName>
    <Version>0.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>Night Tech Solutions</Company>
    <Product>Night Tech Private AI</Product>
    <Copyright>Copyright (c) Night Tech Solutions</Copyright>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The page files sit next to the program, so it finds them whatever folder it's started from. -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NightTech.Business.Core\NightTech.Business.Core.csproj" />
  </ItemGroup>

</Project>
