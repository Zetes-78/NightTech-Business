<Window x:Class="NightTech.AiSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Night Tech AI Setup"
        Width="1180" Height="860" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Page}"
        Icon="Assets/logo-icon.png"
        Closing="Window_Closing">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource Navy}" Padding="20,14">
      <DockPanel>
        <Border DockPanel.Dock="Left" Background="White" CornerRadius="8" Padding="4" Margin="0,0,14,0">
          <Image Source="Assets/logo-icon.png" Width="40" Height="40" />
        </Border>
        <TextBlock DockPanel.Dock="Right" x:Name="VersionText" Foreground="#A9BFD9" VerticalAlignment="Center" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Night Tech AI Setup" Foreground="White" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="Sets up Night Tech Private AI on this computer: an AI assistant that runs here, for this network only."
                     Foreground="#DBE7F5" FontSize="13" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Activity" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,4" />
        <ListBox x:Name="LogList" Height="90" BorderThickness="0" FontFamily="Consolas" FontSize="12" />
      </DockPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid Margin="20,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- Left: computer and choices -->
        <StackPanel Grid.Column="0">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="CheckButton" Content="Check again" Style="{StaticResource PlainButton}" Click="Check_Click" />
                <TextBlock Text="1. This computer" Style="{StaticResource SectionTitle}" />
              </DockPanel>
              <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Processor" Foreground="{StaticResource Muted}" Margin="0,2,16,2" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CpuText" Text="-" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Text="Memory" Foreground="{StaticResource Muted}" Margin="0,2,16,2" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RamText" Text="-" />
                <TextBlock Grid.Row="2" Text="Graphics" Foreground="{StaticResource Muted}" Margin="0,2,16,2" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="GpuText" Text="-" TextWrapping="Wrap" />
                <TextBlock Grid.Row="3" Text="Free disk" Foreground="{StaticResource Muted}" Margin="0,2,16,2" />
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DiskText" Text="-" />
                <TextBlock Grid.Row="4" Text="Windows" Foreground="{StaticResource Muted}" Margin="0,2,16,2" />
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="WinText" Text="-" TextWrapping="Wrap" />
              </Grid>
              <Border Background="{StaticResource OrangeSoft}" BorderBrush="{StaticResource Orange}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock x:Name="RecommendText" FontWeight="SemiBold" TextWrapping="Wrap" Text="Checking this computer..." />
                  <TextBlock x:Name="NotesText" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource Muted}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="2. AI model" Style="{StaticResource SectionTitle}" />
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,8"
                         Text="The recommended model is picked for you. Models marked 'too big' will be slow or won't load on this computer." />
              <ComboBox x:Name="ModelBox" DisplayMemberPath="Label" SelectionChanged="ModelBox_SelectionChanged" Padding="6,5" />
              <TextBlock x:Name="ModelInfo" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource Muted}" />
              <CheckBox x:Name="UsOnlyBox" Content="Only models from US companies (Google, Meta, Microsoft, OpenAI)" Margin="0,8,0,0" Click="UsOnly_Click" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Right: details, install, done -->
        <StackPanel Grid.Column="2">
          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Grid.ColumnSpan="2" Text="3. Customer and administrator" Style="{StaticResource SectionTitle}" />
              <TextBlock Grid.Row="1" Text="Name shown in the AI" VerticalAlignment="Center" />
              <TextBox Grid.Row="1" Grid.Column="1" x:Name="CustomerBox" Margin="0,4" MaxLength="80" />
              <TextBlock Grid.Row="2" Text="Hub ticket #" VerticalAlignment="Center" />
              <TextBox Grid.Row="2" Grid.Column="1" x:Name="TicketBox" Margin="0,4" />
              <TextBlock Grid.Row="3" Text="Technician" VerticalAlignment="Center" />
              <TextBox Grid.Row="3" Grid.Column="1" x:Name="TechBox" Margin="0,4" />
              <TextBlock Grid.Row="4" Text="Admin user name" VerticalAlignment="Center" />
              <TextBox Grid.Row="4" Grid.Column="1" x:Name="AdminBox" Margin="0,4" />
              <TextBlock Grid.Row="5" Text="Admin full name" VerticalAlignment="Center" />
              <TextBox Grid.Row="5" Grid.Column="1" x:Name="AdminNameBox" Margin="0,4" />
              <TextBlock Grid.Row="6" Text="Admin password" VerticalAlignment="Center" />
              <PasswordBox Grid.Row="6" Grid.Column="1" x:Name="PasswordBox1" Margin="0,4" Padding="6,5" />
              <TextBlock Grid.Row="7" Text="Type it again" VerticalAlignment="Center" />
              <PasswordBox Grid.Row="7" Grid.Column="1" x:Name="PasswordBox2" Margin="0,4" Padding="6,5" />
              <TextBlock Grid.Row="8" Text="Port" VerticalAlignment="Center" />
              <TextBox Grid.Row="8" Grid.Column="1" x:Name="PortBox" Margin="0,4" Text="8080" Width="90" HorizontalAlignment="Left" />
              <TextBlock Grid.Row="9" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6,0,0"
                         Text="The customer chooses the admin password, or changes it at first sign-in (My account). We never keep it. If the admin account already exists, its password is left as it is." />
            </Grid>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="4. Install" Style="{StaticResource SectionTitle}" />
              <Button x:Name="InstallButton" Content="Install Private AI" Style="{StaticResource PrimaryButton}" Click="Install_Click" />
              <Button x:Name="StopButton" Content="Stop" Style="{StaticResource PlainButton}" Margin="0,8,0,0" Click="Stop_Click" IsEnabled="False" />
              <ItemsControl x:Name="StepList" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,3">
                      <TextBlock DockPanel.Dock="Left" Text="{Binding Mark}" Foreground="{Binding MarkColor}" FontWeight="Bold" Width="28" FontFamily="Consolas" />
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="TransferText" Margin="0,10,0,4" FontWeight="SemiBold" TextWrapping="Wrap" />
              <ProgressBar x:Name="Bar" Height="16" Minimum="0" Maximum="100" Foreground="{StaticResource Orange}" />
              <TextBlock x:Name="TransferDetail" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" x:Name="DoneCard" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="5. Ready" Style="{StaticResource SectionTitle}" />
              <TextBlock TextWrapping="Wrap" Text="Open Private AI on this computer, or from any computer or phone on this network at:" />
              <TextBox x:Name="AddressesText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontFamily="Consolas" Margin="0,6" />
              <WrapPanel>
                <Button Content="Open Private AI" Style="{StaticResource PrimaryButton}" Click="Open_Click" Margin="0,0,10,0" />
                <Button Content="Open the setup report" Style="{StaticResource PlainButton}" Click="OpenReport_Click" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Remove Private AI" Style="{StaticResource SectionTitle}" />
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Text="Stops Private AI and removes the program, startup task and firewall rule. The AI engine and models stay installed." />
              <CheckBox x:Name="DeleteDataBox" Content="Also delete accounts, chats and the document library" />
              <Button x:Name="RemoveButton" Content="Remove Private AI" Style="{StaticResource PlainButton}" Click="Remove_Click" HorizontalAlignment="Left" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
