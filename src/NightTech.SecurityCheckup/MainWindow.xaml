<Window x:Class="NightTech.SecurityCheckup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Night Tech Security Checkup"
        Width="1180" Height="860" MinWidth="940" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Page}"
        Icon="Assets/logo-icon.png">
  <DockPanel>

    <Border DockPanel.Dock="Top" Background="{StaticResource Navy}" Padding="20,14">
      <DockPanel>
        <Border DockPanel.Dock="Left" Background="White" CornerRadius="8" Padding="4" Margin="0,0,14,0">
          <Image Source="Assets/logo-icon.png" Width="40" Height="40" />
        </Border>
        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
          <TextBlock x:Name="VersionText" Foreground="#A9BFD9" HorizontalAlignment="Right" />
          <TextBlock x:Name="ModeText" Foreground="#A9BFD9" HorizontalAlignment="Right" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Night Tech Security Checkup" Foreground="White" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="Checks a business computer's security settings, asks the owner a few questions, and writes a plain-language report. Read only: nothing is changed."
                     Foreground="#DBE7F5" FontSize="13" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Activity" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,4" />
        <ListBox x:Name="LogList" Height="80" BorderThickness="0" FontFamily="Consolas" FontSize="12" />
      </DockPanel>
    </Border>

    <Grid Margin="20,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="400" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="1. The business" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="Business name" Foreground="{StaticResource Muted}" />
              <TextBox x:Name="BusinessBox" Margin="0,2,0,8" MaxLength="100" />
              <TextBlock Text="Ticket number (from Night Tech Hub)" Foreground="{StaticResource Muted}" />
              <TextBox x:Name="TicketBox" Margin="0,2,0,8" MaxLength="20" />
              <TextBlock Text="Technician" Foreground="{StaticResource Muted}" />
              <TextBox x:Name="TechBox" Margin="0,2,0,0" MaxLength="80" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="2. Ask the owner" Style="{StaticResource SectionTitle}" />
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,8"
                         Text="A computer can't show these. Ask once per business: the answers carry over to each computer you check today." />
              <ItemsControl x:Name="QuestionList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,0,0,10">
                      <TextBlock Text="{Binding Question}" TextWrapping="Wrap" />
                      <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}" Margin="0,4,0,0" Width="150" HorizontalAlignment="Left" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="3. Check this computer" Style="{StaticResource SectionTitle}" />
              <Button x:Name="RunButton" Content="Run the checkup" Style="{StaticResource PrimaryButton}" Click="Run_Click" />
              <ProgressBar x:Name="Busy" Height="6" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed" />
              <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                         Text="Takes under a minute. Nothing is changed." />
              <Border x:Name="AdminCard" Margin="0,10,0,0" Padding="10" Background="{StaticResource OrangeSoft}" CornerRadius="6">
                <StackPanel>
                  <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                             Text="Not running as administrator: drive encryption and the security chip can't be checked." />
                  <Button Content="Restart as administrator" Style="{StaticResource PlainButton}" Click="Elevate_Click" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="4. Reports" Style="{StaticResource SectionTitle}" />
              <Button x:Name="OpenReportButton" Content="Open the owner's report" Style="{StaticResource PlainButton}" Margin="0,0,0,8" IsEnabled="False" Click="OpenReport_Click" />
              <Button Content="Business summary (combine computers)" Style="{StaticResource PlainButton}" Margin="0,0,0,8" Click="Combine_Click" />
              <Button Content="Open reports folder" Style="{StaticResource PlainButton}" Click="OpenFolder_Click" />
              <TextBlock x:Name="SavedText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <TabControl Grid.Column="2" x:Name="Tabs" Background="White" BorderBrush="{StaticResource Line}">
        <TabItem Header="  Results  ">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
            <StackPanel>
              <TextBlock x:Name="SummaryText" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Navy}" Margin="0,0,0,10" TextWrapping="Wrap"
                         Text="Fill in the business, ask the owner the questions, then click &quot;Run the checkup&quot;." />
              <ItemsControl x:Name="ResultList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{Binding Accent}" Background="{Binding Soft}" BorderThickness="5,0,0,0" Padding="10,8" Margin="0,0,0,8" CornerRadius="3">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal">
                          <Border Background="{Binding Accent}" CornerRadius="3" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" Foreground="White" FontSize="11" FontWeight="Bold" />
                          </Border>
                          <TextBlock Text="{Binding Area}" Foreground="{StaticResource Muted}" Margin="0,0,8,0" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="{Binding Found}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Fix}" TextWrapping="Wrap" Margin="0,2,0,0" FontWeight="SemiBold" Visibility="{Binding FixVisibility}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="  Full report  ">
          <TextBox x:Name="FullText" IsReadOnly="True" FontFamily="Consolas" FontSize="12" BorderThickness="0"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Padding="8" />
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
