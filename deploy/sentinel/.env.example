# Copy to .env (never commit .env).
# The address technicians and client PCs use, e.g. sentinel.nighttech.solutions
SENTINEL_DOMAIN=sentinel.example.com

# Only for the Cloudflare Tunnel setup.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: email alerts for critical problems and help requests.
SENTINEL_SMTP_HOST=
SENTINEL_SMTP_PORT=587
SENTINEL_SMTP_USER=
SENTINEL_SMTP_PASSWORD=
SENTINEL_ALERT_FROM=
SENTINEL_ALERT_TO=
